PORT=4100
# Browser origin(s), comma-separated. Local Vite uses 5173.
# On EC2 behind nginx (port 80) use http://YOUR_PUBLIC_IP or https://your.domain
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=people-dev-secret-change-me
DATA_DIR=./data

# Optional SMTP. Leave unset to use Ethereal (MVP test inbox with preview URL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=People <people@example.com>
SMTP_SECURE=false
