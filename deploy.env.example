# JWT secret — required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Public URL of the UI (no trailing slash). Used if anything talks to the API cross-origin.
# Same-origin nginx proxy on port 80 usually means: http://YOUR_EC2_PUBLIC_IP
CORS_ORIGIN=http://localhost

# Host port for the UI (80 on EC2). Local machines can use 8090 if 80 is busy.
HTTP_PORT=80

# Optional SMTP. Leave blank to use Ethereal test inboxes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=People <people@example.com>
SMTP_SECURE=false
